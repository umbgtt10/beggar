{
  "version": "0.6.0",
  "rows": [
    {
      "id": "no-chunks",
      "commands": ["StartRecovery", "AdoptRecovery"],
      "situation": "`chunks` is 0",
      "output": "RecoveryRejected",
      "rejection": "NoChunks"
    },
    {
      "id": "self-addressed",
      "commands": ["StartRecovery", "AdoptRecovery"],
      "situation": "`sender` is `receiver`",
      "output": "RecoveryRejected",
      "rejection": "SelfAddressed"
    },
    {
      "id": "not-a-party",
      "commands": ["StartRecovery", "AdoptRecovery"],
      "situation": "this instance's node is neither `sender` nor `receiver`",
      "output": "RecoveryRejected",
      "rejection": "NotAParty"
    },
    {
      "id": "start-registry-full",
      "commands": ["StartRecovery"],
      "situation": "the open sessions number the bound",
      "output": "RecoveryRejected",
      "rejection": "RegistryFull"
    },
    {
      "id": "start-started",
      "commands": ["StartRecovery"],
      "situation": "otherwise: the next name is minted and a session opened under it",
      "output": "RecoveryStarted"
    },
    {
      "id": "own-session",
      "commands": ["AdoptRecovery"],
      "situation": "`session_id` was minted by this instance: its node and incarnation are this instance's",
      "output": "RecoveryRejected",
      "rejection": "OwnSession"
    },
    {
      "id": "adopt-unaffected",
      "commands": ["AdoptRecovery"],
      "situation": "a session named `session_id` is open, with the same `chunks`, `sender` and `receiver`",
      "output": "RecoveryUnaffected"
    },
    {
      "id": "adopt-conflicted",
      "commands": ["AdoptRecovery"],
      "situation": "a session named `session_id` is open, with a different `chunks`, `sender` or `receiver`",
      "output": "RecoveryConflicted"
    },
    {
      "id": "adopt-registry-full",
      "commands": ["AdoptRecovery"],
      "situation": "no session named `session_id` is open, and the open sessions number the bound",
      "output": "RecoveryRejected",
      "rejection": "RegistryFull"
    },
    {
      "id": "adopt-started",
      "commands": ["AdoptRecovery"],
      "situation": "otherwise: a session is opened under `session_id`, minting nothing",
      "output": "RecoveryStarted"
    },
    {
      "id": "empty-run",
      "commands": ["SendRecoveryPartial", "ReceiveRecoveryPartial"],
      "situation": "`last` is below `first`",
      "output": "RecoveryRejected",
      "rejection": "EmptyRun"
    },
    {
      "id": "partial-not-started",
      "commands": ["SendRecoveryPartial", "ReceiveRecoveryPartial"],
      "situation": "no open session has the name `session_id`",
      "output": "RecoveryNotStarted"
    },
    {
      "id": "misattributed",
      "commands": ["SendRecoveryPartial", "ReceiveRecoveryPartial"],
      "situation": "`sender` or `receiver` differs from the session's",
      "output": "RecoveryRejected",
      "rejection": "Misattributed"
    },
    {
      "id": "wrong-side",
      "commands": ["SendRecoveryPartial", "ReceiveRecoveryPartial"],
      "situation": "reported on the wrong end: a send where this instance's node is the session's receiver, a receive where it is the session's sender",
      "output": "RecoveryRejected",
      "rejection": "WrongSide"
    },
    {
      "id": "chunk-out-of-range",
      "commands": ["SendRecoveryPartial", "ReceiveRecoveryPartial"],
      "situation": "the run reaches outside `1..=chunks`, at either end",
      "output": "RecoveryRejected",
      "rejection": "ChunkOutOfRange"
    },
    {
      "id": "partial-advanced",
      "commands": ["SendRecoveryPartial", "ReceiveRecoveryPartial"],
      "situation": "the run holds a chunk not yet in the chunk set, and the chunk set is not then full",
      "output": "RecoveryAdvanced"
    },
    {
      "id": "partial-completed",
      "commands": ["SendRecoveryPartial", "ReceiveRecoveryPartial"],
      "situation": "the run holds a chunk not yet in the chunk set, and the chunk set is then full: the session is evicted",
      "output": "RecoveryCompleted"
    },
    {
      "id": "partial-unaffected",
      "commands": ["SendRecoveryPartial", "ReceiveRecoveryPartial"],
      "situation": "otherwise: every chunk of the run is already in the chunk set",
      "output": "RecoveryUnaffected"
    },
    {
      "id": "cancel-cancelled",
      "commands": ["CancelRecovery"],
      "situation": "a session named `session_id` is open: it is evicted",
      "output": "RecoveryCancelled"
    },
    {
      "id": "cancel-unaffected",
      "commands": ["CancelRecovery"],
      "situation": "otherwise: no session named `session_id` is open",
      "output": "RecoveryUnaffected"
    },
    {
      "id": "query-not-started",
      "commands": ["ShowRecovery", "ListMissingChunks"],
      "situation": "no session named `session_id` is open or retained",
      "output": "RecoveryNotStarted"
    },
    {
      "id": "recovery-shown",
      "commands": ["ShowRecovery"],
      "situation": "otherwise: the open session of that name, or the retained one that finished last",
      "output": "RecoveryShown"
    },
    {
      "id": "missing-chunks-listed",
      "commands": ["ListMissingChunks"],
      "situation": "otherwise: the chunks of the open session of that name, or of the retained one that finished last, not in its chunk set",
      "output": "MissingChunksListed"
    },
    {
      "id": "recoveries-listed",
      "commands": ["ListRecoveries"],
      "situation": "always: the names of the open sessions",
      "output": "RecoveriesListed"
    },
    {
      "id": "show-registry",
      "commands": ["ShowRegistry"],
      "situation": "always: the checkpoint, describing the state after the call",
      "output": "RegistryShown"
    }
  ]
}
